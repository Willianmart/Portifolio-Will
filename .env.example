# Public site URL (used in metadata / sitemap). Examples:
# NEXT_PUBLIC_SITE_URL=https://willianmart.github.io/Portifolio-Will
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=https://willianmart.github.io/Portifolio-Will

# Set automatically by the Pages workflow (do not set on Vercel):
# GITHUB_PAGES=true
# NEXT_PUBLIC_BASE_PATH=/Portifolio-Will

# Web3Forms access key — when missing, the contact form shows an honest fallback
# (mailto / WhatsApp) instead of fake success.
# Create a key at https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
